type OrderContractRecord = {
    tenant_id: string;
    id: string;
    name: string;
    status: number;
    created_at: string;
    updated_at: string | null;
    del_flag: number;
};

type OrderContractResponse<T> = {
    code: number;
    message: string;
    data?: T;
    request_id: string;
};

type OrderContractHeaders = { [name: string]: unknown };

export interface operations {
    get_business_orders: {
        parameters: {
            query?: { page?: number; page_size?: number; name?: string; status?: number };
            header?: never;
            path?: never;
            cookie?: never;
        };
        requestBody?: never;
        responses: { 200: { headers: OrderContractHeaders; content: { "application/json": OrderContractResponse<{ items: OrderContractRecord[]; page: number; page_size: number; total: number; total_pages: number; max_page_size: number }> } } };
    };
    get_business_orders_by_id: {
        parameters: { query?: never; header?: never; path: { id: string }; cookie?: never };
        requestBody?: never;
        responses: { 200: { headers: OrderContractHeaders; content: { "application/json": OrderContractResponse<OrderContractRecord> } } };
    };
    post_business_orders: {
        parameters: { query?: never; header?: never; path?: never; cookie?: never };
        requestBody: { content: { "application/json": { name: string; status: number } } };
        responses: { 200: { headers: OrderContractHeaders; content: { "application/json": OrderContractResponse<OrderContractRecord> } } };
    };
    put_business_orders_by_id: {
        parameters: { query?: never; header?: never; path: { id: string }; cookie?: never };
        requestBody: { content: { "application/json": { name: string; status: number } } };
        responses: { 200: { headers: OrderContractHeaders; content: { "application/json": OrderContractResponse<OrderContractRecord> } } };
    };
    delete_business_orders_by_id: {
        parameters: { query?: never; header?: never; path: { id: string }; cookie?: never };
        requestBody?: never;
        responses: { 200: { headers: OrderContractHeaders; content: { "application/json": OrderContractResponse<null> } } };
    };
