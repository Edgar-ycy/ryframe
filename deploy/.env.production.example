# 复制为部署平台的受控环境变量；不要提交真实密码、令牌或私钥。
# 从稳定标签源码在部署环境构建、扫描并推送到受控内部仓库后，填写该镜像的不可变摘要。
RYFRAME_IMAGE=registry.internal.example/ryframe@sha256:replace-with-deployment-built-digest
RYFRAME_API_PORT=8080
RYFRAME_API_SNOWFLAKE_WORKER_ID=1
RYFRAME_WORKER_SNOWFLAKE_WORKER_ID=2

APP_DATABASE_HOST=mysql.internal.example
APP_DATABASE_PORT=3306
APP_DATABASE_NAME=ryframe
APP_DATABASE_USERNAME=ryframe
# SQL 日志仅用于受控的短时排障；生产常态必须保持 off。
APP_DATABASE_SQL_LOG_LEVEL=off
APP_DATABASE_SQL_SLOW_THRESHOLD_MS=200
APP_REDIS_HOST=redis.internal.example
APP_REDIS_PORT=6380
APP_OBJECT_STORAGE_ENDPOINT=https://object-storage.internal.example
APP_OBJECT_STORAGE_REGION=us-east-1
APP_PROXY_TRUSTED_CIDRS=10.0.0.0/8
APP_LOGGER_LEVEL=info
APP_LOGGER_FORMAT=json
APP_LOGGER_OUTPUT=stdout
APP_LOGGER_RETENTION_DAYS=7
APP_MESSAGING_ENABLED=true
APP_MESSAGING_TICKET_TTL_SECONDS=60
APP_MESSAGING_RETENTION_DAYS=90
APP_MESSAGING_MAX_CONNECTIONS_PER_USER=5
APP_MESSAGING_OUTBOUND_BUFFER=256
APP_MESSAGING_MAX_RECIPIENTS_PER_MESSAGE=100000
APP_MESSAGING_REPLAY_INTERVAL_SECONDS=15
APP_MESSAGING_REPLAY_JITTER_SECONDS=5
APP_MESSAGING_REPLAY_BATCH_SIZE=100
APP_TELEMETRY_ENABLED=false
APP_TELEMETRY_ENDPOINT=http://otel-collector.internal.example:4318/v1/traces
APP_TELEMETRY_SERVICE_NAME=ryframe
APP_TELEMETRY_SAMPLE_RATIO=0.1
APP_TELEMETRY_EXPORT_TIMEOUT_SECS=5
APP_TELEMETRY_MAX_QUEUE_SIZE=2048

# 以下文件由部署平台在宿主机生成，内容不得提交到 Git。
# 数据库副本和业务数据源文件必须是 JSON 数组；无配置时写入 []。
RYFRAME_DATABASE_PASSWORD_FILE=/run/ryframe-secrets/database-password
RYFRAME_DATABASE_REPLICAS_FILE=/run/ryframe-secrets/database-replicas.json
RYFRAME_DATABASE_SOURCES_FILE=/run/ryframe-secrets/database-sources.json
RYFRAME_REDIS_PASSWORD_FILE=/run/ryframe-secrets/redis-password
RYFRAME_OBJECT_STORAGE_ACCESS_KEY_FILE=/run/ryframe-secrets/object-storage-access-key
RYFRAME_OBJECT_STORAGE_SECRET_KEY_FILE=/run/ryframe-secrets/object-storage-secret-key
RYFRAME_AUTH_JWT_SECRET_FILE=/run/ryframe-secrets/auth-jwt-secret
RYFRAME_METRICS_BEARER_TOKEN_FILE=/run/ryframe-secrets/metrics-bearer-token

RYFRAME_MYSQL_CA_FILE=/run/ryframe-secrets/mysql-ca.pem
RYFRAME_MYSQL_CLIENT_CERT_FILE=/run/ryframe-secrets/mysql-client-cert.pem
RYFRAME_MYSQL_CLIENT_KEY_FILE=/run/ryframe-secrets/mysql-client-key.pem
RYFRAME_REDIS_CA_FILE=/run/ryframe-secrets/redis-ca.pem
RYFRAME_REDIS_CLIENT_CERT_FILE=/run/ryframe-secrets/redis-client-cert.pem
RYFRAME_REDIS_CLIENT_KEY_FILE=/run/ryframe-secrets/redis-client-key.pem
