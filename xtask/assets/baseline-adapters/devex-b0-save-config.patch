diff --git a/xtask/src/dev/measure_config.rs b/xtask/src/dev/measure_config.rs
new file mode 100644
index 0000000000000000000000000000000000000000..d824142a45bc2c35f9e7b21b1d106ca89360f752
--- /dev/null
+++ b/xtask/src/dev/measure_config.rs
@@ -0,0 +1,90 @@
+use std::{
+    ffi::OsStr,
+    fs,
+    path::{Component, Path, PathBuf},
+};
+
+use crate::Result;
+
+#[derive(Debug, Clone)]
+pub(super) struct MeasurementConfig(PathBuf);
+
+impl MeasurementConfig {
+    pub(super) fn bind(root: &Path, directory: &Path) -> Result<Self> {
+        if !directory.is_absolute()
+            || directory
+                .components()
+                .any(|part| matches!(part, Component::ParentDir))
+        {
+            return Err("测量配置必须是无父级跳转的绝对目录".into());
+        }
+        let selected = Self(directory.to_path_buf());
+        selected.verify()?;
+        let directory = directory.canonicalize()?;
+        if directory.starts_with(root.canonicalize()?) {
+            return Err("测量配置必须独立于本次 B0 后端工作树".into());
+        }
+        if std::env::vars_os().any(|(name, _)| is_app_override(&name)) {
+            return Err("测量配置不接受继承的历史应用覆盖；请清理子进程环境后重试".into());
+        }
+        Ok(selected)
+    }
+
+    pub(super) fn directory(&self) -> &Path {
+        &self.0
+    }
+
+    pub(super) fn verify(&self) -> Result<()> {
+        for path in self.0.ancestors() {
+            require_plain(path, true)?;
+        }
+        for name in ["app.toml", "app.dev.toml"] {
+            require_plain(&self.0.join(name), false)?;
+        }
+        for entry in fs::read_dir(&self.0)? {
+            require_plain(&entry?.path(), false)?;
+        }
+        Ok(())
+    }
+
+    pub(super) fn read<T>(&self, operation: impl FnOnce(&Path) -> Result<T>) -> Result<T> {
+        self.verify()?;
+        operation(&self.0).map_err(|_| {
+            format!(
+                "无法读取或校验私有测量配置 {}；请核对固定配置文件",
+                self.0.display()
+            )
+            .into()
+        })
+    }
+}
+
+fn require_plain(path: &Path, directory: bool) -> Result<()> {
+    let metadata = fs::symlink_metadata(path)
+        .map_err(|error| format!("无法检查测量配置路径 {}：{}", path.display(), error.kind()))?;
+    let expected = if directory {
+        metadata.is_dir()
+    } else {
+        metadata.is_file()
+    };
+    if !expected || metadata.file_type().is_symlink() || is_reparse_point(&metadata) {
+        return Err(format!("测量配置要求普通目录和文件，拒绝链接：{}", path.display()).into());
+    }
+    Ok(())
+}
+
+#[cfg(windows)]
+fn is_reparse_point(metadata: &fs::Metadata) -> bool {
+    use std::os::windows::fs::MetadataExt;
+    metadata.file_attributes() & 0x0400 != 0
+}
+
+#[cfg(not(windows))]
+fn is_reparse_point(_metadata: &fs::Metadata) -> bool {
+    false
+}
+
+fn is_app_override(name: &OsStr) -> bool {
+    let name = name.to_string_lossy().to_ascii_uppercase();
+    (name.starts_with("APP_") && name != "APP_ENV") || name == "SNOWFLAKE_WORKER_ID"
+}
diff --git a/xtask/src/dev/measure_tests.rs b/xtask/src/dev/measure_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..6ad53c74ac75752e0d9ddf198805d874f85dda2e
--- /dev/null
+++ b/xtask/src/dev/measure_tests.rs
@@ -0,0 +1,104 @@
+use super::*;
+use crate::dev::runtime_secrets::{
+    RuntimeSecrets, runtime_config_matches_snapshot, snapshot_config_tree,
+};
+use crate::watch::WatchEvent;
+
+struct Fixture(PathBuf);
+
+impl Fixture {
+    fn new(name: &str) -> Self {
+        let root = std::env::temp_dir().join(format!(
+            "ryframe-xtask-b0-save-{name}-{}",
+            std::process::id()
+        ));
+        fs::create_dir(&root).unwrap();
+        Self(root)
+    }
+}
+
+impl Drop for Fixture {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.0);
+    }
+}
+
+const PRIVATE_CONFIG: &[u8] = b"[app]\nport = 11880\n";
+
+#[test]
+fn b0_measurement_config_save_uses_only_selected_file_and_restores_exact_bytes() {
+    let fixture = Fixture::new("watched");
+    let root = fixture.0.join("backend");
+    let versioned = root.join("config/app.dev.toml");
+    fs::create_dir_all(versioned.parent().unwrap()).unwrap();
+    fs::write(&versioned, "[app]\nport = 8000\n").unwrap();
+    let directory = fixture.0.join("private configuration");
+    fs::create_dir(&directory).unwrap();
+    fs::write(directory.join("app.toml"), "# private fixture\n").unwrap();
+    let selected = directory.join("app.dev.toml");
+    fs::write(&selected, PRIVATE_CONFIG).unwrap();
+    let config = MeasurementConfig::bind(&root, &directory).unwrap();
+    let watcher = SourceWatcher::with_measurement_config(&root, Some(config.directory())).unwrap();
+    let session =
+        DevSession::prepare_isolated(&fixture.0.join("state"), watcher.current_revision())
+            .unwrap()
+            .with_measurement_config(Some(config));
+    let runtime = fixture.0.join("snapshot");
+    let secrets = session
+        .read_source_config(&root, |path| snapshot_config_tree(path, &runtime))
+        .unwrap();
+    let untouched = b"[app]\nport = 8001\n";
+    fs::write(&versioned, untouched).unwrap();
+    assert!(
+        watcher
+            .recv_timeout(Duration::from_millis(250))
+            .unwrap()
+            .is_none()
+    );
+    let (mut edit, _) = edit_case_source(&root, &session, SaveCase::ConfigOnly, "fixture").unwrap();
+    let Some(WatchEvent::BackendChanged { revision, paths }) =
+        watcher.recv_timeout(Duration::from_secs(3)).unwrap()
+    else {
+        panic!("外置配置原子保存应触发历史逻辑变更");
+    };
+    let batch = watcher
+        .drain_changes(revision, paths, Duration::from_millis(100))
+        .unwrap();
+    assert_eq!(batch.paths, ["config/app.dev.toml".to_owned()].into());
+    assert!(
+        session
+            .read_source_config(&root, |path| runtime_config_matches_snapshot(
+                path, &runtime, &secrets
+            ))
+            .unwrap()
+    );
+    assert_ne!(fs::read(&selected).unwrap(), PRIVATE_CONFIG);
+    finish_source_edit(Ok(()), &mut edit).unwrap();
+    assert_eq!(fs::read(&selected).unwrap(), PRIVATE_CONFIG);
+    assert_eq!(fs::read(&versioned).unwrap(), untouched);
+}
+
+#[test]
+fn b0_measurement_config_rejects_unbound_or_nonfile_inputs_and_hides_private_parser_text() {
+    let fixture = Fixture::new("rejected");
+    let root = fixture.0.join("backend");
+    let versioned = root.join("config");
+    let private = fixture.0.join("private");
+    fs::create_dir_all(&versioned).unwrap();
+    fs::create_dir(&private).unwrap();
+    for path in [&versioned, &private] {
+        fs::write(path.join("app.toml"), "").unwrap();
+        fs::write(path.join("app.dev.toml"), PRIVATE_CONFIG).unwrap();
+    }
+    assert!(MeasurementConfig::bind(&root, &versioned).is_err());
+    assert!(MeasurementConfig::bind(&root, Path::new("relative")).is_err());
+    let bound = MeasurementConfig::bind(&root, &private).unwrap();
+    let app_dev = private.join("app.dev.toml");
+    fs::write(&app_dev, "password = 'synthetic-secret\n").unwrap();
+    let error = bound.read(RuntimeSecrets::capture).unwrap_err().to_string();
+    assert!(error.contains("私有测量配置"));
+    assert!(!error.contains("synthetic-secret"));
+    fs::remove_file(&app_dev).unwrap();
+    fs::create_dir(&app_dev).unwrap();
+    assert!(bound.read(RuntimeSecrets::capture).is_err());
+}
