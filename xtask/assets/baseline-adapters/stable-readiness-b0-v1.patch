+    #[test]
+    fn first_claim_and_budget_reset_preserve_monotonic_sequence() {
+        assert_eq!(next_claim_counts(0, 5, 0).unwrap(), (1, 1));
+        assert_eq!(next_claim_counts(4, 5, 9).unwrap(), (5, 10));
+        assert_eq!(next_claim_counts(0, 5, 10).unwrap(), (1, 11));
+    }
+
+    #[test]
+    fn invalid_budget_counts_and_sequence_overflow_are_rejected() {
+        for (attempts, maximum, sequence) in [
+            (-1, 5, 0),
+            (0, 0, 0),
+            (0, 101, 0),
+            (2, 5, 1),
+            (0, 5, -1),
+            (5, 5, 5),
+            (i32::MAX, 100, i64::MAX),
+            (0, 5, i64::MAX),
+        ] {
+            assert!(next_claim_counts(attempts, maximum, sequence).is_err());
+        }
+    }
+}
