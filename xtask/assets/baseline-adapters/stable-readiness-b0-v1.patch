+fn next_claim_counts(attempts: i32, max_attempts: i32, sequence: i64) -> AppResult<(i32, i64)> {
+    if attempts < 0 || !(1..=100).contains(&max_attempts) || sequence < i64::from(attempts) {
+        return Err(AppError::Database("后台任务领取计数违反数据库约束".into()));
+    }
+    if attempts >= max_attempts {
+        return Err(AppError::Database("后台任务领取预算已耗尽".into()));
+    }
+    let attempts = attempts
+        .checked_add(1)
+        .ok_or_else(|| AppError::Database("后台任务尝试次数溢出".into()))?;
+    let sequence = sequence
+        .checked_add(1)
+        .ok_or_else(|| AppError::Database("后台任务领取序号溢出".into()))?;
+    Ok((attempts, sequence))
+}
