+use std::collections::BTreeMap;
+
+use super::super::{
+    business_migration_ledger::{DDL, NAME},
+    expected::extend_schema,
+    normalize::normalize_check_clause,
+    types::{ActualCheck, ActualColumn, ActualIndex, ActualTable, ExpectedSchema},
+};
+use super::{verify_checks, verify_columns, verify_indexes, verify_tables};
+
+fn ledger_schema() -> ExpectedSchema {
+    let mut expected = ExpectedSchema::default();
+    extend_schema(&mut expected, [DDL]).unwrap();
+    expected
+}
+
+fn ledger_tables() -> BTreeMap<String, ActualTable> {
+    BTreeMap::from([(
+        NAME.into(),
+        ActualTable {
+            engine: "innodb".into(),
+            character_set: "utf8mb4".into(),
+            collation: "utf8mb4_0900_ai_ci".into(),
+        },
+    )])
+}
+
+#[test]
+fn business_ledger_requires_exact_table_collation_columns_and_primary_key() {
+    let expected = ledger_schema();
+    assert_eq!(expected.tables.len(), 1);
+    assert_eq!(expected.columns.len(), 10);
+    assert_eq!(expected.indexes.len(), 1);
+    assert!(expected.foreign_keys.is_empty());
+    let mut tables = ledger_tables();
+    let mut indexes = BTreeMap::from([(
+        (NAME.into(), "PRIMARY".into()),
+        ActualIndex {
+            unique: true,
+            index_type: "btree".into(),
+            visible: true,
+            columns: [(1, "scope"), (2, "module_name"), (3, "migration_id")]
+                .map(|(index, name)| (index, name.into(), None))
+                .to_vec(),
+        },
+    )]);
+    let mut problems = Vec::new();
+    verify_tables(&expected, &tables, &mut problems);
+    verify_indexes(&expected, &tables, &indexes, &mut problems);
+    assert!(problems.is_empty(), "{problems:?}");
+
+    tables.get_mut(NAME).unwrap().collation = "utf8mb4_general_ci".into();
+    tables.insert(
+        "unknown_business_table".into(),
+        ledger_tables().remove(NAME).unwrap(),
+    );
+    indexes
+        .get_mut(&(NAME.into(), "PRIMARY".into()))
+        .unwrap()
+        .columns
+        .pop();
+    verify_tables(&expected, &tables, &mut problems);
+    verify_indexes(&expected, &tables, &indexes, &mut problems);
+    assert!(problems.iter().any(|value| value.contains("collation")));
+    assert!(
+        problems
+            .iter()
+            .any(|value| value == "unexpected application table unknown_business_table")
+    );
+    assert!(problems.iter().any(|value| value
+        == "index ryframe_business_migration.PRIMARY does not match canonical definition"));
+}
+
+#[test]
+fn business_ledger_preserves_timestamp_precision_and_nullable_adoption_hash() {
+    let mut expected = ledger_schema();
+    expected
+        .columns
+        .retain(|(_, name), _| matches!(name.as_str(), "applied_at" | "adoption_hash"));
+    let tables = ledger_tables();
+    let mut columns = BTreeMap::from([
+        (
+            (NAME.into(), "applied_at".into()),
+            ActualColumn {
+                column_type: "timestamp(6)".into(),
+                nullable: false,
+                default: Some("CURRENT_TIMESTAMP(6)".into()),
+                extra: String::new(),
+                character_set: None,
+                collation: None,
+                generation_expression: String::new(),
+            },
+        ),
+        (
+            (NAME.into(), "adoption_hash".into()),
+            ActualColumn {
+                column_type: "char(64)".into(),
+                nullable: true,
+                default: None,
+                extra: String::new(),
+                character_set: Some("utf8mb4".into()),
+                collation: Some("utf8mb4_0900_ai_ci".into()),
+                generation_expression: String::new(),
+            },
+        ),
+    ]);
+    let mut problems = Vec::new();
+    verify_columns(&expected, &tables, &columns, &mut problems);
+    assert!(problems.is_empty(), "{problems:?}");
+    columns
+        .get_mut(&(NAME.into(), "applied_at".into()))
+        .unwrap()
+        .column_type = "timestamp".into();
+    columns
+        .get_mut(&(NAME.into(), "adoption_hash".into()))
+        .unwrap()
+        .nullable = false;
+    verify_columns(&expected, &tables, &columns, &mut problems);
+    assert_eq!(problems.len(), 2, "{problems:?}");
+    columns.remove(&(NAME.into(), "adoption_hash".into()));
+    problems.clear();
+    verify_columns(&expected, &tables, &columns, &mut problems);
+    assert!(problems.contains(&"missing column ryframe_business_migration.adoption_hash".into()));
+}
+
+#[test]
+fn business_ledger_origin_check_requires_both_adoption_branches_and_enforcement() {
+    let expected = ledger_schema();
+    assert_eq!(expected.checks.len(), 1);
+    let tables = ledger_tables();
+    let key = (NAME.into(), "chk_business_origin".into());
+    let mut checks = BTreeMap::from([(
+        key.clone(),
+        ActualCheck {
+            clause: normalize_check_clause(
+                "((`origin` = _utf8mb4'executed' AND `adoption_hash` IS NULL) OR (`origin` = _utf8mb4'adopted' AND `adoption_hash` IS NOT NULL))",
+            ),
+            enforced: true,
+        },
+    )]);
+    let mut problems = Vec::new();
+    verify_checks(&expected, &tables, &checks, &mut problems);
+    assert!(problems.is_empty(), "{problems:?}");
+    let actual = checks.get_mut(&key).unwrap();
+    actual.clause = normalize_check_clause("origin = 'executed'");
+    actual.enforced = false;
+    verify_checks(&expected, &tables, &checks, &mut problems);
+    assert_eq!(problems.len(), 2, "{problems:?}");
+}
